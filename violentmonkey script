// ==UserScript==
// @name        Comix Deep Scraper
// @namespace   comix_downloader
// @match       https://comix.to/title/*
// @grant       GM_setClipboard
// @version     3.0
// @run-at      document-idle
// ==/UserScript==

(function() {
    'use strict';

    const box = document.createElement('div');
    box.style = "position: fixed; top: 10px; right: 10px; z-index: 99999; background: #18181b; color: #fff; padding: 15px; border: 1px solid #a855f7; border-radius: 12px; font-family: sans-serif; width: 240px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); border-left: 4px solid #a855f7;";
    box.innerHTML = `
        <div style="color: #a855f7; font-weight: 800; font-size: 14px; margin-bottom: 12px; display: flex; align-items: center; justify-content: center;">
            <span style="margin-right: 8px;">🚀</span> COMIX SCRA-P v3
        </div>
        <div id="stats" style="background: #27272a; padding: 8px; border-radius: 6px; font-size: 11px; margin-bottom: 10px; color: #d4d4d8;">
            Links Found: <span id="count" style="color: #a855f7; font-weight: bold;">0</span><br>
            Status: <span id="status">Waiting for scroll...</span>
        </div>
        <button id="btn-grab" style="width: 100%; padding: 10px; background: #a855f7; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; margin-bottom: 6px; transition: 0.2s;">1. Scan & Pick Best</button>
        <button id="btn-copy" style="width: 100%; padding: 10px; background: #3b82f6; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; display: none;">2. Copy to Clipboard</button>
    `;
    document.body.appendChild(box);

    let finalMap = new Map();

    const updateUI = () => {
        const links = Array.from(document.querySelectorAll('a')).filter(a => a.href.includes('chapter-'));
        document.getElementById('count').innerText = links.length;
        if (links.length > 0) {
            document.getElementById('status').innerText = "Chapters detected!";
            document.getElementById('status').style.color = "#22c55e";
        }
    };

    // Auto-scan every second to catch "Lazy Loading"
    setInterval(updateUI, 1000);

    document.getElementById('btn-grab').addEventListener('click', () => {
        const allLinks = Array.from(document.querySelectorAll('a')).filter(a => a.href.includes('chapter-'));

        if (allLinks.length === 0) {
            alert("Still no chapters found. Please scroll down to the chapter list and wait 1 second for them to load!");
            return;
        }

        allLinks.forEach(link => {
            const url = link.href;
            // Get text from the whole row/container
            const row = link.closest('div, tr, li') || link;
            const text = row.innerText.toLowerCase();

            // Extract Ch number (handles decimals like 1.5)
            const numMatch = url.match(/chapter-(\d+(\.\d+)?)/i);
            const chNum = numMatch ? parseFloat(numMatch[1]) : url;

            const isOfficial = text.includes('official');
            const likesMatch = text.match(/(\d+(\.\d+)?k?)\s*(likes|👍)/i) || text.match(/(\d+)\s*$/);
            const likes = likesMatch ? parseInt(likesMatch[1].replace('k', '000')) : 0;

            const score = (isOfficial ? 1000000 : 0) + likes;

            if (!finalMap.has(chNum) || score > finalMap.get(chNum).score) {
                finalMap.set(chNum, { url, score, row });
            }
        });

        // Highlight what we picked
        finalMap.forEach(item => {
            if (item.row && item.row.style) item.row.style.outline = "2px solid #a855f7";
        });

        document.getElementById('btn-copy').style.display = "block";
        document.getElementById('status').innerText = `Ready! ${finalMap.size} selected.`;
    });

    document.getElementById('btn-copy').addEventListener('click', () => {
        const sorted = Array.from(finalMap.keys()).sort((a, b) => a - b);
        const output = sorted.map(num => finalMap.get(num).url).join(' ');
        GM_setClipboard(output);
        alert("Links copied! Go to your Python script and paste.");
    });

})();
